# AI Video Studio v3.0 — Production Environment Template
# Copy to .env and fill strong credentials before running:
#   docker compose -f infra/compose/docker-compose.prod.yml up -d --build

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_SECRET
POSTGRES_DB=ai_video_studio

API_PORT=8000
WEB_PORT=8080

# Optional: Pluggable OpenAI-Compatible / Ollama LLM Provider
# Leave empty to use built-in deterministic local planner
AIVS_LLM_BASE_URL=
AIVS_LLM_MODEL=
AIVS_LLM_API_KEY=

# Phase 4 Stage 2: Observability & Rate Limiting
AIVS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AIVS_RATE_LIMIT_MAX=300
AIVS_RATE_LIMIT_WINDOW_SEC=60
AIVS_MAX_UPLOAD_BYTES=2147483648

# Sprint 4 global platform plugin registry (use a dedicated DB login granted plugin_registry_runtime)
AIVS_PLATFORM_REGISTRY_DATABASE_URL=postgresql://aivs_platform_registry_login:change_me@localhost:5432/aivs
AIVS_PLATFORM_ADMIN_TOKEN=replace_with_a_long_random_secret
