{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-video-studio:schema:creative-brief:v2",
  "title": "Creative Brief Version v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_platform",
    "audience",
    "objective",
    "language",
    "duration_range_sec",
    "aspect_ratio"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "target_platform": { "enum": ["youtube_shorts", "tiktok", "instagram_reels", "douyin", "xiaohongshu", "linkedin", "generic"] },
    "audience": { "type": "string", "minLength": 1, "maxLength": 500 },
    "objective": { "enum": ["acquisition", "education", "brand", "entertainment", "conversion"] },
    "language": { "type": "string", "minLength": 2, "maxLength": 20 },
    "duration_range_sec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 5, "maximum": 600 },
        "max": { "type": "integer", "minimum": 10, "maximum": 600 }
      }
    },
    "aspect_ratio": { "enum": ["9:16", "16:9", "1:1"] },
    "style": { "type": "string", "maxLength": 200 },
    "hook_type": { "type": "string", "maxLength": 200 },
    "cta": { "type": "string", "maxLength": 300 },
    "brand_tone": { "type": "string", "maxLength": 300 },
    "must_include": { "type": "array", "items": { "type": "string" } },
    "forbidden_topics": { "type": "array", "items": { "type": "string" } },
    "subtitle_template": { "type": "string", "default": "default" },
    "target_video_count": { "type": "integer", "minimum": 1, "maximum": 20, "default": 3 }
  }
}
