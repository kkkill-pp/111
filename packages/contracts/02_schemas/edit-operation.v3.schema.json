{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-video-studio:schema:edit-operation:v3",
  "title": "Edit Operation v3.0 (21 Canonical Operations; UNDO/REDO Excluded)",
  "description": "Strict Draft 2020-12 schema for all 21 canonical timeline EditOperations. UNDO and REDO are independent version commands (POST /timelines/{timeline_id}/undo and /redo) and are strictly forbidden here.",
  "$defs": {
    "operation_type": {
      "enum": [
        "ADD_CLIP",
        "REMOVE_CLIP",
        "TRIM_CLIP",
        "MOVE_CLIP",
        "SPLIT_CLIP",
        "MERGE_CLIP",
        "REORDER_CLIP",
        "UPDATE_TRANSFORM",
        "UPDATE_PLAYBACK_RATE",
        "UPDATE_VOLUME",
        "ADD_SUBTITLE",
        "UPDATE_SUBTITLE",
        "REMOVE_SUBTITLE",
        "ADD_TRANSITION",
        "REMOVE_TRANSITION",
        "ADD_OVERLAY",
        "REMOVE_OVERLAY",
        "SET_CANVAS_PROFILE",
        "ADD_KEYFRAME",
        "APPLY_EFFECT",
        "ADD_MARKER"
      ]
    },
    "agent_permission_level": {
      "enum": ["L0", "L1", "L2", "L3"]
    },
    "undo_scope": {
      "enum": ["user_edit", "proposal_batch", "non_undoable_system"],
      "description": "Classifies the undo stack boundary so user edits, AI proposal batches, and non-reversible system actions are never mixed."
    },
    "operation_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "operation_type", "payload"],
      "properties": {
        "operation_id": { "type": "string", "format": "uuid" },
        "operation_type": { "$ref": "#/$defs/operation_type" },
        "payload": { "type": "object" },
        "reason": { "type": "string", "maxLength": 2000 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "risk_level": { "enum": ["low", "medium", "high", "critical"] },
        "reversible": { "type": "boolean", "default": true }
      },
      "allOf": [
        {
          "if": { "properties": { "operation_type": { "const": "ADD_CLIP" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["track_id", "asset_id", "source_in", "source_out", "timeline_start"], "properties": { "track_id": { "type": "string", "format": "uuid" }, "asset_id": { "type": "string", "format": "uuid" }, "source_in": { "type": "integer", "minimum": 0 }, "source_out": { "type": "integer", "minimum": 1 }, "timeline_start": { "type": "integer", "minimum": 0 }, "playback_rate": { "type": "number", "minimum": 0.25, "maximum": 4.0, "default": 1.0 } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "REMOVE_CLIP" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["clip_id"], "properties": { "clip_id": { "type": "string", "format": "uuid" }, "ripple": { "type": "boolean", "default": false } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "TRIM_CLIP" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["clip_id", "new_source_in", "new_source_out"], "properties": { "clip_id": { "type": "string", "format": "uuid" }, "new_source_in": { "type": "integer", "minimum": 0 }, "new_source_out": { "type": "integer", "minimum": 1 } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "MOVE_CLIP" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["clip_id", "target_timeline_start"], "properties": { "clip_id": { "type": "string", "format": "uuid" }, "target_track_id": { "type": "string", "format": "uuid" }, "target_timeline_start": { "type": "integer", "minimum": 0 } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "SPLIT_CLIP" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["clip_id", "split_at_timeline_tick"], "properties": { "clip_id": { "type": "string", "format": "uuid" }, "split_at_timeline_tick": { "type": "integer", "minimum": 1 } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "MERGE_CLIP" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["first_clip_id", "second_clip_id"], "properties": { "first_clip_id": { "type": "string", "format": "uuid" }, "second_clip_id": { "type": "string", "format": "uuid" } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "REORDER_CLIP" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["track_id", "ordered_clip_ids"], "properties": { "track_id": { "type": "string", "format": "uuid" }, "ordered_clip_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uuid" } } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "UPDATE_TRANSFORM" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["clip_id", "transform"], "properties": { "clip_id": { "type": "string", "format": "uuid" }, "transform": { "type": "object", "required": ["mode"] } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "UPDATE_PLAYBACK_RATE" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["clip_id", "playback_rate"], "properties": { "clip_id": { "type": "string", "format": "uuid" }, "playback_rate": { "type": "number", "minimum": 0.25, "maximum": 4.0 } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "UPDATE_VOLUME" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["clip_id", "volume"], "properties": { "clip_id": { "type": "string", "format": "uuid" }, "volume": { "type": "number", "minimum": 0.0, "maximum": 4.0 }, "enabled": { "type": "boolean" }, "pan": { "type": "number", "minimum": -1.0, "maximum": 1.0 } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "ADD_SUBTITLE" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["track_id", "timeline_start", "duration", "text"], "properties": { "track_id": { "type": "string", "format": "uuid" }, "timeline_start": { "type": "integer", "minimum": 0 }, "duration": { "type": "integer", "minimum": 1 }, "text": { "type": "string", "minLength": 1, "maxLength": 500 }, "style_preset": { "type": "string" }, "safe_zone": { "enum": ["bottom", "center_seam", "top"] } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "UPDATE_SUBTITLE" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["subtitle_id"], "properties": { "subtitle_id": { "type": "string", "format": "uuid" }, "text": { "type": "string", "minLength": 1, "maxLength": 500 }, "timeline_start": { "type": "integer", "minimum": 0 }, "duration": { "type": "integer", "minimum": 1 }, "style_preset": { "type": "string" } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "REMOVE_SUBTITLE" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["subtitle_id"], "properties": { "subtitle_id": { "type": "string", "format": "uuid" } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "ADD_TRANSITION" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["clip_id", "type", "duration_ticks", "position"], "properties": { "clip_id": { "type": "string", "format": "uuid" }, "type": { "enum": ["cut", "fade_in", "fade_out", "crossfade"] }, "duration_ticks": { "type": "integer", "minimum": 0 }, "position": { "enum": ["in", "out", "between"] } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "REMOVE_TRANSITION" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["transition_id"], "properties": { "transition_id": { "type": "string", "format": "uuid" } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "ADD_OVERLAY" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["track_id", "kind", "timeline_start", "duration"], "properties": { "track_id": { "type": "string", "format": "uuid" }, "kind": { "enum": ["text_hook", "image", "logo", "lower_third"] }, "timeline_start": { "type": "integer", "minimum": 0 }, "duration": { "type": "integer", "minimum": 1 }, "asset_id": { "type": ["string", "null"], "format": "uuid" }, "text": { "type": ["string", "null"], "maxLength": 200 } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "REMOVE_OVERLAY" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["overlay_id"], "properties": { "overlay_id": { "type": "string", "format": "uuid" } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "SET_CANVAS_PROFILE" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["width", "height", "frame_rate"], "properties": { "width": { "type": "integer", "minimum": 16, "multipleOf": 2 }, "height": { "type": "integer", "minimum": 16, "multipleOf": 2 }, "frame_rate": { "type": "object", "required": ["num", "den"], "properties": { "num": { "type": "integer", "minimum": 1 }, "den": { "type": "integer", "minimum": 1 } } }, "aspect_preset": { "enum": ["9:16", "16:9", "1:1", "custom"] } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "ADD_KEYFRAME" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["target_id", "property", "timeline_tick", "value", "easing"], "properties": { "target_id": { "type": "string", "format": "uuid" }, "property": { "enum": ["position_x", "position_y", "scale", "rotation_deg", "opacity", "volume", "pan"] }, "timeline_tick": { "type": "integer", "minimum": 0 }, "value": { "type": "number" }, "easing": { "enum": ["linear", "ease_in", "ease_out", "ease_in_out", "hold"] } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "APPLY_EFFECT" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["target_id", "effect_type", "params"], "properties": { "target_id": { "type": "string", "format": "uuid" }, "effect_type": { "enum": ["brightness_contrast", "saturation", "gaussian_blur", "lut_3d", "audio_eq", "audio_denoise", "loudnorm"] }, "enabled": { "type": "boolean", "default": true }, "params": { "type": "object" } } } } }
        },
        {
          "if": { "properties": { "operation_type": { "const": "ADD_MARKER" } } },
          "then": { "properties": { "payload": { "additionalProperties": false, "required": ["timeline_tick", "label", "kind"], "properties": { "timeline_tick": { "type": "integer", "minimum": 0 }, "label": { "type": "string", "minLength": 1, "maxLength": 200 }, "kind": { "enum": ["chapter", "beat", "review_note", "cut_point", "ai_highlight"] }, "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } } } } }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "timeline_id",
    "base_version",
    "operation_type",
    "payload",
    "actor",
    "undo_scope",
    "originating_request_id",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": { "const": "3.0" },
    "operation_id": { "type": "string", "format": "uuid" },
    "proposal_id": { "type": ["string", "null"], "format": "uuid" },
    "timeline_id": { "type": "string", "format": "uuid" },
    "base_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Optimistic concurrency lock version; TimelineService MUST return 409 Conflict if current_version != base_version."
    },
    "result_version": { "type": ["integer", "null"], "minimum": 2 },
    "operation_type": { "$ref": "#/$defs/operation_type" },
    "payload": { "type": "object" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["user", "agent", "system"] },
        "id": { "type": "string", "minLength": 1 },
        "permission_level": { "$ref": "#/$defs/agent_permission_level" }
      }
    },
    "undo_scope": { "$ref": "#/$defs/undo_scope" },
    "reversible": { "type": "boolean", "default": true },
    "originating_user_id": { "type": ["string", "null"], "format": "uuid" },
    "originating_request_id": { "type": "string", "format": "uuid" },
    "reason": { "type": "string", "maxLength": 2000 },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "risk_level": { "enum": ["low", "medium", "high", "critical"] },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 200 }
  }
}
