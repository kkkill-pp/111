{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-video-studio:schema:timeline:v3",
  "title": "Canonical Timeline v3.0 (Frozen Core Protocol)",
  "description": "Immutable, versioned multi-track timeline snapshot using exact rational timebases. Extends v2.2 with keyframes, effects, markers, AudioItem on audio tracks, and unified playback_rate (legacy speed field is strictly disallowed and must be migrated via CR-001).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timeline_id",
    "project_id",
    "version",
    "time_semantics",
    "profile",
    "tracks",
    "markers"
  ],
  "properties": {
    "schema_version": { "const": "3.0" },
    "timeline_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing optimistic concurrency version. Every mutation produces a new immutable version."
    },
    "parent_version": { "type": ["integer", "null"], "minimum": 1 },
    "origin_command": {
      "enum": ["init", "storyboard_compile", "edit", "proposal_apply", "undo", "redo"],
      "default": "edit"
    },
    "undo_scope": {
      "enum": ["user_edit", "proposal_batch", "non_undoable_system"],
      "default": "user_edit",
      "description": "Enforces Undo/Redo boundary so user edits, AI proposal batches, and system/render actions are never mixed into an undifferentiated undo stack."
    },
    "snapshot_checksum": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "time_semantics": { "$ref": "#/$defs/time_semantics" },
    "profile": { "$ref": "#/$defs/profile" },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/track" }
    },
    "markers": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/marker" }
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num", "den"],
      "properties": {
        "num": { "type": "integer", "minimum": 1 },
        "den": { "type": "integer", "minimum": 1 }
      }
    },
    "time_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "timeline_timebase", "frame_rate", "rounding_policy", "coordinate_model"],
      "description": "Explicit rational time semantics shared identically by Web editor preview and FFmpeg RenderPlan compiler.",
      "properties": {
        "unit": { "const": "ticks" },
        "timeline_timebase": {
          "$ref": "#/$defs/rational",
          "description": "Project timeline tick unit in seconds (e.g. 1/30000 s or 1/90000 s). Governs all project-time fields (timeline_start, duration, marker.timeline_tick, keyframe.timeline_tick)."
        },
        "frame_rate": {
          "$ref": "#/$defs/rational",
          "description": "Nominal project frame rate in frames per second (e.g. 30000/1001 for 29.97fps or 30/1 for 30fps)."
        },
        "rounding_policy": {
          "const": "half_to_even",
          "description": "Deterministic integer tick rounding rule when converting source-media ticks via playback_rate into project-timeline ticks."
        },
        "coordinate_model": {
          "const": "half_open_source_and_project_ticks",
          "description": "Source media intervals are [source_range.in, source_range.out) in source_range.timebase; project placements are [timeline_start, timeline_start + duration) in timeline_timebase."
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "frame_rate", "timeline_timebase", "audio_sample_rate"],
      "properties": {
        "width": { "type": "integer", "minimum": 16, "multipleOf": 2 },
        "height": { "type": "integer", "minimum": 16, "multipleOf": 2 },
        "frame_rate": { "$ref": "#/$defs/rational" },
        "timeline_timebase": { "$ref": "#/$defs/rational" },
        "audio_sample_rate": { "type": "integer", "enum": [44100, 48000] },
        "pixel_aspect_ratio": { "$ref": "#/$defs/rational" },
        "aspect_preset": { "enum": ["9:16", "16:9", "1:1", "custom"] }
      }
    },
    "source_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in", "out", "timebase"],
      "description": "Half-open interval [in, out) in source media timebase. Service MUST enforce out > in.",
      "properties": {
        "in": { "type": "integer", "minimum": 0 },
        "out": { "type": "integer", "minimum": 1 },
        "timebase": { "$ref": "#/$defs/rational" },
        "vfr_pts_map_ref": { "type": ["string", "null"] }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "duration_ticks", "position"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": { "enum": ["cut", "fade_in", "fade_out", "crossfade"] },
        "duration_ticks": { "type": "integer", "minimum": 0 },
        "position": { "enum": ["in", "out", "between"] }
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "property", "timeline_tick", "value", "easing"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "property": {
          "enum": ["position_x", "position_y", "scale", "rotation_deg", "opacity", "volume", "pan"]
        },
        "timeline_tick": {
          "type": "integer",
          "minimum": 0,
          "description": "Project-timeline tick in time_semantics.timeline_timebase."
        },
        "value": { "type": "number" },
        "easing": { "enum": ["linear", "ease_in", "ease_out", "ease_in_out", "hold"] }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "effect_type", "enabled", "params"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "effect_type": {
          "enum": ["brightness_contrast", "saturation", "gaussian_blur", "lut_3d", "audio_eq", "audio_denoise", "loudnorm"]
        },
        "enabled": { "type": "boolean", "default": true },
        "params": { "type": "object" }
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timeline_tick", "label", "kind"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "timeline_tick": { "type": "integer", "minimum": 0 },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "enum": ["chapter", "beat", "review_note", "cut_point", "ai_highlight"] },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#F59E0B" },
        "metadata": { "type": "object" }
      }
    },
    "video_clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asset_id", "source_range", "timeline_start", "duration", "playback_rate"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "asset_id": { "type": "string", "format": "uuid" },
        "source_range": { "$ref": "#/$defs/source_range" },
        "timeline_start": { "type": "integer", "minimum": 0 },
        "duration": { "type": "integer", "minimum": 1 },
        "playback_rate": { "type": "number", "minimum": 0.25, "maximum": 4.0 },
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "enum": ["fit", "fill", "manual", "face_track", "split", "screencast", "wide", "inset", "general"]
            },
            "scale": { "type": "number", "minimum": 0.1, "maximum": 10.0 },
            "position_x": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "position_y": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "rotation_deg": { "type": "number", "minimum": -360.0, "maximum": 360.0 },
            "opacity": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "crop_override_json": { "type": ["object", "null"] }
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "volume": { "type": "number", "minimum": 0.0, "maximum": 4.0 },
            "fade_in_ticks": { "type": "integer", "minimum": 0 },
            "fade_out_ticks": { "type": "integer", "minimum": 0 }
          }
        },
        "transitions": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/transition" }
        },
        "keyframes": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/keyframe" }
        },
        "effects": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/effect" }
        }
      }
    },
    "audio_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asset_id", "source_range", "timeline_start", "duration", "playback_rate"],
      "description": "Standard clip entity inside an audio track (unified timeline, no separate audio timeline).",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "asset_id": { "type": "string", "format": "uuid" },
        "source_range": { "$ref": "#/$defs/source_range" },
        "timeline_start": { "type": "integer", "minimum": 0 },
        "duration": { "type": "integer", "minimum": 1 },
        "playback_rate": { "type": "number", "minimum": 0.25, "maximum": 4.0 },
        "role": { "enum": ["dialogue", "music", "sfx", "voiceover", "ambient"], "default": "dialogue" },
        "volume": { "type": "number", "minimum": 0.0, "maximum": 4.0, "default": 1.0 },
        "pan": { "type": "number", "minimum": -1.0, "maximum": 1.0, "default": 0.0 },
        "muted": { "type": "boolean", "default": false },
        "fade_in_ticks": { "type": "integer", "minimum": 0, "default": 0 },
        "fade_out_ticks": { "type": "integer", "minimum": 0, "default": 0 },
        "keyframes": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/keyframe" }
        },
        "effects": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/effect" }
        }
      }
    },
    "subtitle_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timeline_start", "duration", "text"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "timeline_start": { "type": "integer", "minimum": 0 },
        "duration": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "speaker_label": { "type": ["string", "null"] },
        "style_preset": { "type": "string", "default": "default" },
        "safe_zone": { "enum": ["bottom", "center_seam", "top"], "default": "bottom" },
        "word_timings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["word", "start_tick", "end_tick"],
            "properties": {
              "word": { "type": "string" },
              "start_tick": { "type": "integer", "minimum": 0 },
              "end_tick": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "overlay_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "timeline_start", "duration"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "kind": { "enum": ["text_hook", "image", "logo", "lower_third"] },
        "timeline_start": { "type": "integer", "minimum": 0 },
        "duration": { "type": "integer", "minimum": 1 },
        "asset_id": { "type": ["string", "null"], "format": "uuid" },
        "text": { "type": ["string", "null"], "maxLength": 200 },
        "position_x": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "position_y": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "scale": { "type": "number", "minimum": 0.05, "maximum": 5.0 },
        "opacity": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "keyframes": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/keyframe" }
        },
        "effects": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/effect" }
        }
      }
    },
    "track": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "order", "clips"],
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "type": { "const": "video" },
            "name": { "type": "string", "maxLength": 120 },
            "order": { "type": "integer", "minimum": 0 },
            "muted": { "type": "boolean", "default": false },
            "locked": { "type": "boolean", "default": false },
            "clips": { "type": "array", "items": { "$ref": "#/$defs/video_clip" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "order", "clips"],
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "type": { "const": "audio" },
            "name": { "type": "string", "maxLength": 120 },
            "order": { "type": "integer", "minimum": 0 },
            "muted": { "type": "boolean", "default": false },
            "locked": { "type": "boolean", "default": false },
            "clips": { "type": "array", "items": { "$ref": "#/$defs/audio_item" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "order", "items"],
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "type": { "const": "subtitle" },
            "name": { "type": "string", "maxLength": 120 },
            "order": { "type": "integer", "minimum": 0 },
            "locked": { "type": "boolean", "default": false },
            "items": { "type": "array", "items": { "$ref": "#/$defs/subtitle_item" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "order", "items"],
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "type": { "const": "overlay" },
            "name": { "type": "string", "maxLength": 120 },
            "order": { "type": "integer", "minimum": 0 },
            "locked": { "type": "boolean", "default": false },
            "items": { "type": "array", "items": { "$ref": "#/$defs/overlay_item" } }
          }
        }
      ]
    }
  }
}
